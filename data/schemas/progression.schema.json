{"$id":"https://outerheavenx.github.io/citadel-of-vesper/schemas/progression.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Leveling curve and per-level growth. See docs/PROGRESSION.md.","properties":{"levelCap":{"minimum":1,"type":"integer"},"statGrowth":{"additionalProperties":false,"description":"Per-level gains applied on level-up.","properties":{"con":{"type":"number"},"dex":{"type":"number"},"hp":{"type":"number"},"int":{"type":"number"},"lck":{"type":"number"},"mp":{"type":"number"},"str":{"type":"number"}},"type":"object"},"xpCurve":{"additionalProperties":false,"description":"XP to go from level N to N+1: floor(base * N^growth).","properties":{"base":{"type":"number"},"growth":{"type":"number"}},"required":["base","growth"],"type":"object"}},"required":["xpCurve","statGrowth","levelCap"],"title":"Progression","type":"object"}